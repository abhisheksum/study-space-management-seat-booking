{
  "name": "studyhub-backend",
  "version": "1.0.0",
  "description": "StudyHub — Study Space Management & Seat Booking Platform API",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "db:schema": "mysql -u root -p studyhub < server/database/schema.sql",
    "db:seed": "mysql -u root -p studyhub < server/database/seed.sql",
    "db:setup": "mysql -u root -p < server/database/schema.sql && mysql -u root -p studyhub < server/database/seed.sql",
    "admin:create": "node server/scripts/createAdmin.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.9.7",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  },
  "nodemonConfig": {
    "watch": [
      "server/"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/",
      "server/database/"
    ]
  }
}
